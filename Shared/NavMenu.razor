// Components/Shared/NavMenu.razor
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">🌳 Admin Árboles</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                @if (_userRole == "Admin")
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/admin/coordinadores" Match="NavLinkMatch.Prefix">
                            👤 Gestión Coordinadores
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/admin/tenants" Match="NavLinkMatch.Prefix">
                            🏢 Gestión Tenants
                        </NavLink>
                    </li>
                }
                @if (_userRole == "Coordinador")
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.Prefix">
                            📊 Dashboard
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/campañas/crear" Match="NavLinkMatch.Prefix">
                            📋 Crear Campaña
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/arboles/registrar" Match="NavLinkMatch.Prefix">
                            🌱 Registrar Árbol
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/inspectores" Match="NavLinkMatch.Prefix">
                            🔍 Inspectores
                        </NavLink>
                    </li>
                }
            </ul>
            @if (_userRole != "Invited")
            {
                <button class="btn btn-outline-light" @onclick="Logout">Cerrar Sesión</button>
            }
        </div>
    </div>
</nav>

@code {
    private string _userRole = "Invited";

    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _userRole = await AuthService.GetUserRoleAsync();
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}