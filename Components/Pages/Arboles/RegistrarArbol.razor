// Components/Pages/Arboles/RegistrarArbol.razor
@page "/arboles/registrar"
@inject IArbolService ArbolService
@inject ICampañaService CampañaService
@inject NavigationManager Navigation

<h3>Registrar Nuevo Árbol</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <label class="form-label">Selecciona la Campaña</label>
        <InputSelect @bind-Value="SelectedCampañaId" class="form-control">
            <option value="">-- Seleccionar --</option>
            @foreach (var camp in Campañas)
            {
                <option value="@camp.Id">@camp.Nombre</option>
            }
        </InputSelect>
    </div>
</div>

@if (!string.IsNullOrEmpty(SelectedCampañaId))
{
    <EditForm Model="@Arbol" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label>Especie</label>
                    <InputText @bind-Value="Arbol.Especie" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>Ubicación</label>
                    <InputText @bind-Value="Arbol.Ubicacion" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>Alumno Asignado</label>
                    <InputText @bind-Value="Arbol.AlumnoAsignado" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label>Altura (m)</label>
                    <InputNumber @bind-Value="Arbol.Altura" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>Diámetro (cm)</label>
                    <InputNumber @bind-Value="Arbol.Diametro" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>Estado</label>
                    <InputSelect @bind-Value="Arbol.Estado" class="form-control">
                        <option value="Vivo">Vivo</option>
                        <option value="Enfermo">Enfermo</option>
                        <option value="Muerto">Muerto</option>
                    </InputSelect>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Observaciones</label>
            <InputTextArea @bind-Value="Arbol.Observaciones" class="form-control" rows="2" />
        </div>

        <button type="submit" class="btn btn-success mt-2">Registrar Árbol</button>
        <button type="button" class="btn btn-secondary mt-2 ms-2" @onclick="() => Navigation.NavigateTo('/dashboard')">Cancelar</button>
    </EditForm>
}

@code {
    private Arbol Arbol { get; set; } = new Arbol();
    private string SelectedCampañaId { get; set; } = string.Empty;
    private List<Campaña> Campañas { get; set; } = new();

    [Inject] private IAuthService AuthService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var usuario = await AuthService.GetCurrentUserAsync();
        if (usuario != null)
        {
            Campañas = await CampañaService.GetCampañasAsync(usuario.TenantId);
        }
    }

    private async Task HandleValidSubmit()
    {
        Arbol.CampañaId = SelectedCampañaId;
        Arbol.FechaPlantacion = DateTime.Now;
        Arbol.FechaUltimaMedicion = DateTime.Now;
        await ArbolService.RegistrarArbolAsync(Arbol);
        Navigation.NavigateTo("/dashboard");
    }
}