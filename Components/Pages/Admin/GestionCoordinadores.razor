// Components/Pages/Admin/GestionCoordinadores.razor
@page "/admin/coordinadores"
@attribute [Authorize(Roles = "Admin")]
@inject ITenantService TenantService
@inject NavigationManager Navigation

<h3>Gestión de Coordinadores</h3>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Asignar Coordinador a Tenant</div>
            <div class="card-body">
                <div class="mb-3">
                    <label>Tenant</label>
                    <InputSelect @bind-Value="SelectedTenantId" class="form-control">
                        <option value="">-- Seleccionar --</option>
                        @foreach (var tenant in Tenants)
                        {
                            <option value="@tenant.Id">@tenant.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label>Email del Coordinador</label>
                    <InputText @bind-Value="CoordinadorEmail" class="form-control" placeholder="coordinador@email.com" />
                </div>
                <button class="btn btn-primary" @onclick="AsignarCoordinador">Asignar Coordinador</button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Coordinadores por Tenant</div>
            <div class="card-body">
                <div class="mb-3">
                    <label>Seleccionar Tenant</label>
                    <InputSelect @bind-Value="SelectedTenantForView" class="form-control" @onchange="LoadCoordinadores">
                        <option value="">-- Seleccionar --</option>
                        @foreach (var tenant in Tenants)
                        {
                            <option value="@tenant.Id">@tenant.Nombre</option>
                        }
                    </InputSelect>
                </div>
                
                @if (Coordinadores.Any())
                {
                    <ul class="list-group">
                        @foreach (var coord in Coordinadores)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @coord.Nombre (@coord.Email)
                                <button class="btn btn-sm btn-danger" @onclick="() => RemoverCoordinador(coord.Id)">Remover</button>
                            </li>
                        }
                    </ul>
                }
                else if (!string.IsNullOrEmpty(SelectedTenantForView))
                {
                    <p>No hay coordinadores asignados a este tenant.</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<Tenant> Tenants { get; set; } = new();
    private List<Usuario> Coordinadores { get; set; } = new();
    private string SelectedTenantId { get; set; } = string.Empty;
    private string SelectedTenantForView { get; set; } = string.Empty;
    private string CoordinadorEmail { get; set; } = string.Empty;

    [Inject] private IAuthService AuthService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Tenants = await TenantService.GetAllTenantsAsync();
    }

    private async Task AsignarCoordinador()
    {
        if (string.IsNullOrEmpty(SelectedTenantId) || string.IsNullOrEmpty(CoordinadorEmail))
            return;

        var usuario = await AuthService.GetUserByEmailAsync(CoordinadorEmail);
        if (usuario != null)
        {
            await TenantService.AsignarCoordinadorAsync(SelectedTenantId, usuario.Id);
            CoordinadorEmail = string.Empty;
            await LoadCoordinadores();
        }
    }

    private async Task LoadCoordinadores()
    {
        if (!string.IsNullOrEmpty(SelectedTenantForView))
        {
            Coordinadores = await TenantService.GetCoordinadoresPorTenantAsync(SelectedTenantForView);
        }
        else
        {
            Coordinadores.Clear();
        }
    }

    private async Task RemoverCoordinador(string coordinadorId)
    {
        if (!string.IsNullOrEmpty(SelectedTenantForView))
        {
            await TenantService.RemoverCoordinadorAsync(SelectedTenantForView, coordinadorId);
            await LoadCoordinadores();
        }
    }
}