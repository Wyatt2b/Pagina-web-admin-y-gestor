// Components/Pages/Campañas/CrearCampaña.razor
@page "/campañas/crear"
@inject ICampañaService CampañaService
@inject NavigationManager Navigation

<h3>Crear Nueva Campaña</h3>

<EditForm Model="@Campaña" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Nombre de la Campaña</label>
                <InputText @bind-Value="Campaña.Nombre" class="form-control" />
                <ValidationMessage For="@(() => Campaña.Nombre)" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Ubicación</label>
                <InputText @bind-Value="Campaña.Ubicacion" class="form-control" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Fecha Inicio</label>
                <InputDate @bind-Value="Campaña.FechaInicio" class="form-control" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Fecha Fin</label>
                <InputDate @bind-Value="Campaña.FechaFin" class="form-control" />
            </div>
        </div>
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <InputTextArea @bind-Value="Campaña.Descripcion" class="form-control" rows="3" />
    </div>

    <button type="submit" class="btn btn-success mt-2">Crear Campaña</button>
    <button type="button" class="btn btn-secondary mt-2 ms-2" @onclick="() => Navigation.NavigateTo('/dashboard')">Cancelar</button>
</EditForm>

@code {
    private Campaña Campaña { get; set; } = new Campaña();

    [Inject] private IAuthService AuthService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var usuario = await AuthService.GetCurrentUserAsync();
        if (usuario != null)
        {
            Campaña.CoordinadorId = usuario.Id;
            Campaña.TenantId = usuario.TenantId;
        }
        Campaña.FechaInicio = DateTime.Now;
        Campaña.FechaFin = DateTime.Now.AddMonths(3);
    }

    private async Task HandleValidSubmit()
    {
        await CampañaService.CreateCampañaAsync(Campaña);
        Navigation.NavigateTo("/dashboard");
    }
}